# Copy to /etc/myweb/.env.prod on the server; never commit real values.
DB_NAME=mywebdb
DB_USER=myweb
DB_PASS=replace-with-a-long-random-database-password
DB_ROOT_PASS=replace-with-a-different-long-root-password
# Must match a registered backend FileStorage implementation.
STORAGE_PROVIDER=minio
# Public URL prefix for StoredFile directory + filename; include trailing / (not a secret).
PUBLIC_FILE_BASE_URL=/storage/mywebbucket/
MINIO_ROOT_USER=myweb-storage
MINIO_ROOT_PASSWORD=replace-with-a-long-random-storage-password
FRONTEND_PORT=8088
MAIL_USER=
MAIL_PASS=
# Optional public OAuth identifiers; REACT_APP_* values are visible in browser JS.
REACT_APP_FRONT_URL=
REACT_APP_BACK_URL=
REACT_APP_KAKAO_REST_API=
REACT_APP_GOOGLE_REST_API=
